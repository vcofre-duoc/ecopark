<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ECOPARK 3.0: mantiene el formulario a la izquierda y la tabla a la derecha.
  Nuevos controles: campo de búsqueda, nuevas horas, columna ID y estadísticas.
  Los fx:id y onAction conectan esta vista con MainController.java.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.ecopark.controller.MainController"
            prefWidth="1120" prefHeight="620">

    <top>
        <VBox spacing="3" alignment="CENTER_LEFT" styleClass="cabecera">
            <padding><Insets top="16" right="22" bottom="12" left="22"/></padding>
            <Label text="EcoPark | Gestión de estadías" styleClass="titulo"/>
            <Label text="Versión 3.0 - JDBC, MySQL, ID autoincrementable y consultas SQL"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="22" alignment="TOP_LEFT">
            <padding><Insets top="14" right="20" bottom="10" left="20"/></padding>

            <!-- Panel izquierdo: registro + UPDATE por ID -->
            <VBox spacing="13" prefWidth="318">
                <Label text="Registrar estadía" styleClass="seccion"/>
                <GridPane hgap="10" vgap="10">
                    <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="tipoCombo" prefWidth="193"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Patente:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="patenteField" promptText="Ej.: ABCD12"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Horas:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="horasField" promptText="De 1 a 24"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <TitledPane text="Beneficio para motocicleta" collapsible="false">
                    <content>
                        <VBox spacing="7">
                            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                            <CheckBox fx:id="convenioCheck" text="Convenio: 20% de descuento"/>
                        </VBox>
                    </content>
                </TitledPane>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Registrar" prefWidth="118" onAction="#registrar"/>
                </HBox>

                <!-- UPDATE solo modifica horas del registro seleccionado -->
                <Separator/>
                <Label text="Actualizar horas de la selección" styleClass="seccion"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="nuevasHorasField" promptText="Nuevas horas" prefWidth="145"/>
                    <Button text="Actualizar" onAction="#actualizarHoras"/>
                </HBox>
                <Label text="Selecciona una fila de la tabla (ID) para actualizarla."
                       wrapText="true" styleClass="ayuda"/>
            </VBox>

            <!-- Panel derecho: búsqueda WHERE, Tabla y estadísticas GROUP BY -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <Label text="Estadías registradas" styleClass="seccion"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Patente:"/>
                    <TextField fx:id="buscarPatenteField" promptText="Buscar en MySQL" prefWidth="170"/>
                    <Button text="Buscar" onAction="#buscarPorPatente"/>
                    <Button text="Ver todos" onAction="#mostrarTodos"/>
                </HBox>

                <TableView fx:id="estadiasTable" prefHeight="330" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="65"/>
                        <TableColumn fx:id="tipoCol" text="Tipo" prefWidth="93"/>
                        <TableColumn fx:id="patenteCol" text="Patente" prefWidth="120"/>
                        <TableColumn fx:id="horasCol" text="Horas" prefWidth="75"/>
                        <TableColumn fx:id="costoCol" text="Costo" prefWidth="120"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Eliminar seleccionado" onAction="#eliminar"/>
                    <Button text="Estadísticas por tipo" onAction="#mostrarEstadisticas"/>
                </HBox>
                <Label fx:id="estadisticasLabel"
                       text="Estadísticas: pulsa el botón para consultar MySQL."
                       wrapText="true" styleClass="estadisticas"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="pie">
            <padding><Insets top="12" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="mensajeLabel" text="Ingresa una estadía o consulta los registros."
                   wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
